# Groq Cloud API Key & Model
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Turso (libSQL) Cloud SQLite Database for Production Multi-User Persistence on Vercel
# Leave unset locally to automatically use ./tabibcare.db
TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# Cryptographic secret for signing HttpOnly session cookies (generate with: openssl rand -hex 32)
SESSION_SECRET=replace_with_a_long_random_secret_in_production
